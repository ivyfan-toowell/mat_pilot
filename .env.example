# Secrets stay on the backend. Never commit .env.
MP_API_KEY=
DASHSCOPE_API_KEY=
OPENALEX_API_KEY=
OPENALEX_TIMEOUT_SECONDS=20
# Beijing endpoint. Change to the endpoint matching your account region.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
RERANK_MODEL=qwen3-rerank
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
SPARSE_CORPUS_LIMIT=10000

# --- Postgres（仅 setup_database / docker-compose 使用；应用运行时读 DATABASE_URL）---
# Run: python -m scripts.setup_database
POSTGRES_USER=matpilot
POSTGRES_PASSWORD=
POSTGRES_DB=matpilot
POSTGRES_PORT=5433
DATABASE_URL=

DATA_DIR=data
# off: 本机单用户，隐式租户 local。api_key: 必须提供 Bearer，并配置 AUTH_API_KEYS。
AUTH_MODE=off
# 格式 tenant_id:key，多条用逗号分隔，例如 team-a:replace-me,team-b:replace-me
AUTH_API_KEYS=
# 进程内异步任务工作线程数（agent / index / extract）
JOB_WORKERS=2
# 全局限流（次/分钟）；0=关闭。付费/长任务另受 RATE_LIMIT_COSTLY_PER_MINUTE 约束
RATE_LIMIT_PER_MINUTE=0
RATE_LIMIT_COSTLY_PER_MINUTE=30
# true 输出 JSON 日志（含 request_id / tenant_id）
LOG_JSON=false
# 启动时自动 DDL；生产可用 alembic upgrade head / python -m scripts.apply_schema
SCHEMA_AUTO_APPLY=true
# 为 mp_chunks.embedding 创建 HNSW 索引（小语料可关）
VECTOR_HNSW=false
LOG_LEVEL=INFO
MP_TIMEOUT_SECONDS=30
# 后端自用；Streamlit 也读取同名环境变量（不经过 Settings）
BACKEND_URL=http://127.0.0.1:8000
# 仅 Streamlit 客户端使用（不在 Settings 中）；AUTH_MODE=api_key 时填与 AUTH_API_KEYS 同值的 key
MATPILOT_API_KEY=

# 迁移顺序提示：
# 1) setup_database  2) migrate_tenant_local（若有旧扁平目录）
# 3) docker compose up -d --wait db  4) apply_schema / alembic / SCHEMA_AUTO_APPLY
# 5) migrate_docs_to_postgres（若有旧 parsed.json）
