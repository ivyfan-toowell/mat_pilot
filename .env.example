# Secrets stay on the backend. Never commit .env.
MP_API_KEY=
DASHSCOPE_API_KEY=
OPENALEX_API_KEY=
OPENALEX_TIMEOUT_SECONDS=20
# Beijing endpoint. Change to the endpoint matching your account region.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
RERANK_MODEL=qwen3-rerank
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
SPARSE_CORPUS_LIMIT=10000

# Run python -m scripts.setup_database to fill local DB credentials without printing them.
POSTGRES_USER=matpilot
POSTGRES_PASSWORD=
POSTGRES_DB=matpilot
POSTGRES_PORT=5433
DATABASE_URL=

DATA_DIR=data
LOG_LEVEL=INFO
MP_TIMEOUT_SECONDS=30
BACKEND_URL=http://127.0.0.1:8000
